[Unit]
Description=webx 补偿器（租约回收 / 准入 / 巡检）
# 对领取服务是软依赖（Wants 而非 Requires）：回收租约只是一次 UPDATE，随后的 poke 失败也只损失延迟。
After=network.target webx-task.service
Wants=webx-task.service

[Service]
Type=simple
# ⚠️ 路径与运行用户按实际部署修改（默认 /opt/webx + www-data）。User 必须能读写 STORAGE_DIR / 日志目录
User=www-data
Group=www-data
WorkingDirectory=/opt/webx

# server.sh 负责选解释器（.venv > uv > python3）并 exec 到服务本体：MainPID 即服务，SIGTERM 直达。
# ⚠️ 刻意不在这里写任何参数：优先级是【命令行 > 环境变量 > .env > 默认值】，写死了改 .env 就不生效，
# 且没有任何报错。监听地址、端口、租约参数、各类间隔一律只在 /opt/webx/.env 里配。
ExecStart=/opt/webx/server.sh reconciler
# 全局只能有**一个**补偿器实例（多个会重复准入 / 重复通知）；本服务不支持多开。

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# 安全加固
NoNewPrivileges=true
PrivateTmp=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webx-reconciler

[Install]
WantedBy=multi-user.target
