[Unit]
Description=webx 独立存储服务
# 与 Web 同机部署时无需单独起；独立机部署时 worker 与 Web 都通过 STORAGE_* 配置访问它。
After=network.target

[Service]
Type=simple
# ⚠️ 路径与运行用户按实际部署修改（默认 /opt/webx + www-data）。User 必须能读写 STORAGE_DIR / 日志目录
User=www-data
Group=www-data
WorkingDirectory=/opt/webx

# server.sh 负责选解释器（.venv > uv > python3）并 exec 到服务本体：MainPID 即服务，SIGTERM 直达。
# ⚠️ 刻意不在这里写任何参数：优先级是【命令行 > 环境变量 > .env > 默认值】，写死了改 .env 就不生效，
# 且没有任何报错。监听地址、端口、租约参数、各类间隔一律只在 /opt/webx/.env 里配。
ExecStart=/opt/webx/server.sh storage
# 多 worker 用 STORAGE_WORKERS（.env）配置。保留期清理是独立进程，默认不随存储启动：
#   python -m webx_storage retention --once   （见 docs/storage-service.md）

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# 安全加固
NoNewPrivileges=true
PrivateTmp=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webx-storage

[Install]
WantedBy=multi-user.target
