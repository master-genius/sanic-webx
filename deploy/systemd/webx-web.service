[Unit]
Description=webx Web 服务（API / 管理端 / 内部回调）
# 数据库可达即可。领取服务与补偿器是软依赖：poke 送不到只损失延迟，任务已经持久在 PENDING 池里。
After=network.target
Wants=webx-task.service webx-reconciler.service

[Service]
Type=simple
# ⚠️ 路径与运行用户按实际部署修改（默认 /opt/webx + www-data）。User 必须能读写 STORAGE_DIR / 日志目录
User=www-data
Group=www-data
WorkingDirectory=/opt/webx

# server.sh 负责选解释器（.venv > uv > python3）并 exec 到服务本体：MainPID 即服务，SIGTERM 直达。
# ⚠️ 刻意不在这里写任何参数：优先级是【命令行 > 环境变量 > .env > 默认值】，写死了改 .env 就不生效，
# 且没有任何报错。监听地址、端口、租约参数、各类间隔一律只在 /opt/webx/.env 里配。
ExecStart=/opt/webx/server.sh web
# worker 进程数默认 4（server.sh 的默认值）。要改请把上面的 ExecStart 改成
#   ExecStart=/opt/webx/server.sh web --workers 2
# 这是上面“不写参数”原则下唯一的例外：进程数没有对应的 .env 配置项。

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# 安全加固
NoNewPrivileges=true
PrivateTmp=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webx-web

[Install]
WantedBy=multi-user.target
