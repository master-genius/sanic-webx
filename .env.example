# webx 通用配置项（业务字段请在自己项目的 .env 中追加）
# 相对路径一律锚定【项目根】，项目根 = configure_root() > WEBX_ROOT > CWD

# ── 应用 ──────────────────────────────────────────
APP_NAME=myapp
# 面向用户的展示名（验证码邮件标题/正文用），留空回落 APP_NAME
APP_DISPLAY_NAME=
APP_ENV=dev
APP_DEBUG=false
# 本部署装配哪些业务模块（逗号分隔）。每个模块按约定提供
# <pkg>/controller（必须）、<pkg>/i18n.py、<pkg>/models（都可选）。
# 服务与 tools/dbsync.py 读的是同一个值，保证「起的服务」与「建的表」范围一致。
# 命令行会覆盖它：./server.sh --modules ... / python tools/dbsync.py --modules ...
WEBX_MODULES=app
# 挂载哪些【内置】路由组（与 WEBX_MODULES 是两个独立开关，内置恒排在业务模块之前）：
#   不配 / 留空 / 值看不懂   四组全挂（默认）
#   false                    一组都不挂，纯业务服务
#   auth,api                 只挂列出的组（可选 auth,api,admin,public）
# 只有显式 false 才不加载——其余一律回退全加载，优先保证服务起得来；
# 组名写错会剔除并打 WARNING，不中止启动。
# ⚠️ 默认全挂会带上用户 CRUD 与整套 admin 权限端点，用不到就配 false，别白送攻击面。
WEBX_BUILTIN=

# ── 数据库 ────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=myapp
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECTION_LIFETIME=3600
DATABASE_STATEMENT_TIMEOUT_MS=25000
DATABASE_LOCK_TIMEOUT_MS=3500
# ⚠️ transaction_timeout 仅 PostgreSQL 17+ 支持；低版本必须保持 0，否则建连即失败
DATABASE_TRANSACTION_TIMEOUT_MS=0

# ── 令牌（生产必须改，长度 >= 16）──────────────────
TOKEN_SECRET=change-me-in-production
TOKEN_EXPIRE_MINUTES=1440
TOKEN_IDS=user,admin
# 内部服务回调用（X-Internal-Token）；留空 = 内部接口一律拒绝
INTERNAL_TOKEN=

# ── 服务器 ────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=9010
REQUEST_MAX_SIZE=104857600

# ── CORS（生产按域名白名单填写，留空 = 不允许跨域）──
CORS_ALLOWED_ORIGINS=
# ⚠️ 逗号后不能带空格（sanic-ext 只 lower 不 strip）
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Internal-Token,X-Lang,Accept-Language
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ── 日志 / 存储 ───────────────────────────────────
# 留空 = 仅控制台（systemd 下进 journald）；非空 = 按小时滚动落盘
WEB_LOG_DIR=

# ── 验证码（webx.services.verifycode_service）────
VERIFY_CODE_COOLDOWN_SECONDS=60
VERIFY_CODE_VALID_MINUTES=5
VERIFY_CODE_DAILY_LIMIT_EMAIL=8
VERIFY_CODE_DAILY_LIMIT_MOBILE=5
VERIFY_CODE_DAILY_LIMIT_BIND=8
VERIFY_CODE_MAX_RETRIES=5
VERIFY_CODE_LOCK_MINUTES=15
# 单 IP 发码总量帽（与「按标识冷却 + 每日上限」叠加，各管一个维度）
IP_RATE_LIMIT_PER_MIN=30
IP_RATE_LIMIT_PER_HOUR=150

# ── 登录安全（User 与 Admin 共用）─────────────────
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=10

# ── 短信（适配层 webx/lib/sms，手机号验证码的发送通道）──
# 总开关，默认 true。真正可用还要求所选服务商的凭证与签名齐备；
# 不想要短信就置 false，手机号入口会统一回「暂未开通」
SMS_ENABLED=true
# 服务商驱动，内置 aliyun；自定义驱动用 webx.lib.sms.register_driver 注册
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
# 场景 → 模板码映射（JSON），新增场景只加配置不改代码。模板变量名须为 ${code}
SMS_TEMPLATES={"verify_code":"SMS_xxxxxxxx"}
# 以下按需：接入点覆盖（私网代理/联调）、号码区号、超时（毫秒，TOTAL 必须大于 READ）
# SMS_ENDPOINT=
# SMS_DEFAULT_COUNTRY_CODE=86
# SMS_CONNECT_TIMEOUT_MS=5000
# SMS_READ_TIMEOUT_MS=10000
# SMS_TOTAL_TIMEOUT_MS=20000

# ── 文件上传 / 下载 ───────────────────────────────
STORAGE_DIR=storage
# 上传端点的上限，由业务层在流式写盘时逐块累计校验。
# ⚠️ 与 REQUEST_MAX_SIZE 互不影响：上传路由是 stream=True，实测 Sanic 的
# REQUEST_MAX_SIZE 对流式路由不生效。想传大文件不必调大 REQUEST_MAX_SIZE。
UPLOAD_MAX_SIZE=104857600
UPLOAD_SESSION_MAX_AGE_HOURS=24
# 单个分片体积上限（字节）。超限回 413，已追加的部分仍按 Upload-Offset 如实计数
UPLOAD_CHUNK_MAX_BYTES=67108864
# 对象键命名规则：strict（字母数字 _ - .）/ lenient（允许中文、空格、括号；
# 仍排除路径分隔符、控制字符，以及点开头的保留名）。要保留用户原始文件名就用 lenient
STORAGE_KEY_RULE=strict
# 下载签名密钥，独立于 TOKEN_SECRET 以便单独轮换；留空则回落 TOKEN_SECRET 并告警
STORAGE_SIGN_SECRET=
STORAGE_SIGN_TTL_SECONDS=3600

# ── 邮件 ──────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=

# ── 业务自有配置（示例）────────────────────────────
WELCOME_TEXT=hello webx

# ── 任务调度（租约 / 领取服务 / 补偿器）─────────────────
# 服务间令牌：领取服务、Web、worker 必须一致。留空 = 拒绝一切内部请求
INTERNAL_TOKEN=
# true = 只有 register_task_type 登记过的类型才能建任务；false = 未登记按默认单阶段
TASK_REQUIRE_REGISTERED_TYPES=false
# 每用户"等待子任务的顶层任务"上限，0=不限
TASK_WAITING_PARENT_MAX=10

# 租约：认领短租约 / 常规租约；grace = clamp(α×已投入时长, MIN, MAX)
LEASE_CLAIM_SECONDS=60
LEASE_SECONDS=100
LEASE_GRACE_ALPHA=0.12
LEASE_GRACE_MIN_SECONDS=180
LEASE_GRACE_MAX_SECONDS=18000
LEASE_REQUEUE_LIMIT=10

# 领取服务（python -m task_server，必须单进程）。默认只绑 127.0.0.1——/task/pokes 不鉴权
TASK_SERVER_URL=http://127.0.0.1:9020
TASK_SERVER_HOST=127.0.0.1
TASK_SERVER_PORT=9020
# 单次领取最长挂起，须小于反代的 proxy_read_timeout
TASK_LEASE_HOLD_SECONDS=25
TASK_LEASE_FALLBACK_SECONDS=1.0

# 补偿器（python tools/reconciler.py，必须单进程）
RECONCILER_SCAN_INTERVAL=600
RECONCILER_STALE_THRESHOLD_MINUTES=60
RECONCILER_QUEUED_TIMEOUT_MINUTES=60
RECONCILER_ABANDON_THRESHOLD_HOURS=168
RECONCILER_NONE_TASK_TIMEOUT_HOURS=3
RECONCILER_ADMIT_INTERVAL=30
RECONCILER_LEASE_INTERVAL=5

# 独立存储服务（客户端侧）：任务模块清理产物时调用；留空 = 只清本地
STORAGE_INTERNAL_URL=

