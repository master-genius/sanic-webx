# webx 通用配置项（业务字段请在自己项目的 .env 中追加）
# 相对路径一律锚定【项目根】，项目根 = configure_root() > WEBX_ROOT > CWD

# ── 应用 ──────────────────────────────────────────
APP_NAME=myapp
# 面向用户的展示名（验证码邮件标题/正文用），留空回落 APP_NAME
APP_DISPLAY_NAME=
APP_ENV=dev
APP_DEBUG=false

# ── 数据库 ────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=myapp
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECTION_LIFETIME=3600
DATABASE_STATEMENT_TIMEOUT_MS=25000
DATABASE_LOCK_TIMEOUT_MS=3500
# ⚠️ transaction_timeout 仅 PostgreSQL 17+ 支持；低版本必须保持 0，否则建连即失败
DATABASE_TRANSACTION_TIMEOUT_MS=0
# 模型模块列表；一般由业务 Settings 覆写，无需在此配置
MODELS_MODULES=

# ── 令牌（生产必须改，长度 >= 16）──────────────────
TOKEN_SECRET=change-me-in-production
TOKEN_EXPIRE_MINUTES=1440
TOKEN_IDS=user,admin
# 内部服务回调用（X-Internal-Token）；留空 = 内部接口一律拒绝
INTERNAL_TOKEN=

# ── 服务器 ────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=9010
REQUEST_MAX_SIZE=104857600

# ── CORS（生产按域名白名单填写，留空 = 不允许跨域）──
CORS_ALLOWED_ORIGINS=
# ⚠️ 逗号后不能带空格（sanic-ext 只 lower 不 strip）
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Internal-Token,X-Lang,Accept-Language
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ── 日志 / 存储 ───────────────────────────────────
# 留空 = 仅控制台（systemd 下进 journald）；非空 = 按小时滚动落盘
WEB_LOG_DIR=

# ── 验证码（webx.contrib.auth）────────────────────
VERIFY_CODE_COOLDOWN_SECONDS=60
VERIFY_CODE_VALID_MINUTES=5
VERIFY_CODE_DAILY_LIMIT_EMAIL=8
VERIFY_CODE_DAILY_LIMIT_MOBILE=5
VERIFY_CODE_DAILY_LIMIT_BIND=8
VERIFY_CODE_MAX_RETRIES=5
VERIFY_CODE_LOCK_MINUTES=15
# 单 IP 发码总量帽（与「按标识冷却 + 每日上限」叠加，各管一个维度）
IP_RATE_LIMIT_PER_MIN=30
IP_RATE_LIMIT_PER_HOUR=150

# ── 登录安全（User 与 Admin 共用）─────────────────
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=10

# ── 短信（webx.contrib.sms，需 pip install webx[sms]）──
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
# 场景 → 模板码映射（JSON），新增场景只加配置不改代码
SMS_TEMPLATES={"verify_code":"SMS_xxxxxxxx"}

# ── 文件上传 / 下载 ───────────────────────────────
STORAGE_DIR=storage
UPLOAD_MAX_SIZE=104857600
UPLOAD_SESSION_MAX_AGE_HOURS=24
# 下载签名密钥，独立于 TOKEN_SECRET 以便单独轮换；留空则回落 TOKEN_SECRET 并告警
STORAGE_SIGN_SECRET=
STORAGE_SIGN_TTL_SECONDS=3600

# ── 邮件 ──────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=

# ── 业务自有配置（示例）────────────────────────────
WELCOME_TEXT=hello webx
